# macOS
.DS_Store

# Obsidian — ignora estado por-máquina, conserva la config compartida del vault
# (app.json sí se versiona para que todo el equipo herede los links en markdown)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/data.json

# Extracción temporal del PRD
/tmp/libox_prd_v11.txt

# --- Node / Next.js (para cuando entre el código) ---
node_modules/
.pnp
.pnp.*
.next/
out/
build/
dist/
coverage/
.turbo/
next-env.d.ts
*.tsbuildinfo

# Variables de entorno (nunca versionar secretos)
.env
.env.*
!.env.example

# Logs y caché
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Claude Code — se comparte la config de equipo, no la personal.
#   .claude/settings.json  → versionado: hooks, plugins y marketplaces del equipo.
#   .claude/skills/        → versionado: skills compartidas.
#   settings.local.json    → personal (permisos, overrides): NUNCA se versiona.
.claude/settings.local.json
.claude/worktrees/

# Tooling de agentes local (copia previa de skills; la fuente ahora es .claude/skills/)
.agents/

# Archivos temporales de FUSE (FS montado)
.fuse_hidden*

# Artefactos generados por Next.js/TypeScript (no versionar)
#   *.tsbuildinfo   → caché de `tsc --noEmit` (tsconfig tiene `incremental: true`).
#   next-env.d.ts   → lo reescriben `next dev` y `next build` con rutas distintas
#                     (.next/dev/types vs .next/types); versionarlo ensucia el árbol
#                     en cada cambio de comando. Es la convención de create-next-app 16.
*.tsbuildinfo
next-env.d.ts
